---
import Base from './Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/patty-io/patty-code';
const { title, description, titleEn, wide } = Astro.props;
---
<Base title={title} description={description} titleEn={titleEn}>
  <header class="nav auth-nav scrolled">
    <div class="nav-inner">
      <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="Patty Code logo" /><span>Patty Code</span></a>
    </div>
  </header>

  <main class="auth-main">
    <div class={wide ? 'auth-card wide' : 'auth-card'}>
      <slot />
    </div>
  </main>

  <footer>
    <div class="foot-sub" style="border-top:none">
      <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="Patty Code logo" /><span>Patty Code</span></a>
      <nav class="foot-links">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/docs/`}>Docs</a>
        <a href={repo}>GitHub</a>
      </nav>
    </div>
  </footer>

  <script>import '../scripts/auth.js';</script>
</Base>
