---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import type { ReleaseItem, ReleaseRecord } from '../data/releases';
import { releasePath } from '../data/releases';
import '../styles/changelog.css';

const { release, releases, canonical } = Astro.props as {
  release: ReleaseRecord;
  releases: ReleaseRecord[];
  canonical?: string;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/patty-io/patty-code';
const prHref = (ref: number) => `${repo}/pull/${ref}`;

const isPreview = release.channel === 'prerelease';
const latestForChannel = releases[0];
const downloadHref = isPreview ? 'https://patty-code.io/?download=desktop#start' : release.links.download;

const kindLabel = (kind: string) => ({
  new: 'New',
  improved: 'Improved',
  fixed: 'Fixed',
  security: 'Security',
}[kind] ?? kind);

const surfaceLabel = (surface: string) => ({
  agent: 'Agent',
  desktop: 'Desktop',
  cli: 'CLI',
  mcp: 'MCP',
  security: 'Security',
  provider: 'Provider',
  plugin: 'Plugins',
}[surface] ?? surface);

/* Sections render only when they have content; numbering is sequential. */
const sectionDefs = [
  ...(release.guides.length ? [{ id: 'guides', en: 'Guides' }] : []),
  { id: 'highlights', en: 'Highlights' },
  ...(['new', 'improved', 'fixed'] as const)
    .filter((kind) => release.changes[kind].length)
    .map((kind) => ({ id: kind, en: kindLabel(kind) })),
  ...(release.upgrade.length ? [{ id: 'upgrade', en: 'Upgrade notes' }] : []),
  ...(release.risks.length ? [{ id: 'risks', en: 'Risk notes' }] : []),
  ...(release.contributors.length ? [{ id: 'thanks', en: 'Thanks' }] : []),
];
const sectionNum = new Map(sectionDefs.map((s, i) => [s.id, String(i + 1).padStart(2, '0')]));
const tocItems = [...sectionDefs, { id: 'download', en: 'Download' }];

/* Version rail: group by minor, show the latest few patches per group,
   older ones behind a native <details> expander. */
const minorKey = (v: string) => v.split('.').slice(0, 2).join('.');
const railGroups: { key: string; items: ReleaseRecord[] }[] = [];
for (const item of releases) {
  const key = minorKey(item.version);
  const last = railGroups[railGroups.length - 1];
  if (last && last.key === key) last.items.push(item);
  else railGroups.push({ key, items: [item] });
}
const RAIL_VISIBLE = 3;

const title = `Patty Code v${release.version} release notes`;
const description = release.summary.en;
---

<Base title={title} titleEn={title} description={description} canonical={canonical} noindex={isPreview}>
  <SiteHeader active="changelog" scrolled />

  <main class="release-stage">
    <div class="release-mobile-switcher">
      <label for="release-version">Version</label>
      <select id="release-version" data-release-version>
        {releases.map((item) => <option value={item.version} selected={item.version === release.version}>v{item.version}</option>)}
      </select>
    </div>

    <div class="release-grid">
      <aside class="release-rail" aria-label="Release versions">
        <div class="release-rail__eyebrow"><span class="release-rail__mark"></span>Release ledger</div>
        <nav>
          {railGroups.map((group) => {
            const channelItems = group.items;
            if (!channelItems.length) return null;
            const visible = channelItems.slice(0, RAIL_VISIBLE);
            const overflow = channelItems.slice(RAIL_VISIBLE);
            return (
              <div class="release-rail__group">
                <p class="release-rail__minor">{group.key}.x</p>
                {visible.map((item) => (
                  <a class:list={["release-version-link", { active: item.version === release.version }]} href={`${base}${releasePath(item.version)}`}>
                    <span class="release-version-link__line"><strong>v{item.version}</strong>{item === latestForChannel && <em>Latest</em>}</span>
                    <small>{item.date}</small>
                  </a>
                ))}
                {overflow.length > 0 && (
                  <details class="release-rail__more" open={overflow.some((item) => item.version === release.version)}>
                    <summary>
                      <span class="when-closed">+{overflow.length} more</span>
                      <span class="when-open">Show less</span>
                    </summary>
                    {overflow.map((item) => (
                      <a class:list={["release-version-link", { active: item.version === release.version }]} href={`${base}${releasePath(item.version)}`}>
                        <span class="release-version-link__line"><strong>v{item.version}</strong>{item === latestForChannel && <em>Latest</em>}</span>
                        <small>{item.date}</small>
                      </a>
                    ))}
                  </details>
                )}
              </div>
            );
          })}
        </nav>
        <a class="release-rail__all" href={`${repo}/releases`}>All GitHub releases ↗</a>
      </aside>

      <article class="release-paper">
        <header class="release-hero">
          <div class="release-hero__meta">
            {isPreview && <span class="release-channel release-channel--preview"><span class="release-channel__dot"></span>Historical archive</span>}
            <time datetime={release.date}>{release.date}</time>
          </div>
          <h1>Patty Code v{release.version}</h1>
          <div class="release-surfaces">
            {release.surfaces.map((surface) => {
              const label = surfaceLabel(surface);
              return <span>{label}</span>;
            })}
          </div>
          {release.builds && (
            <div class="release-builds" aria-label="Published builds">
              <span><strong>CLI</strong> {release.builds.cli}</span>
              <span><strong>Desktop</strong> {release.builds.desktop}</span>
              <span><strong>npm</strong> {release.builds.npm}</span>
            </div>
          )}
          <p class="release-lede">{release.summary.en}</p>
        </header>

        {release.guides.length > 0 && (
          <section id="guides" class="release-section release-guides">
            <div class="release-section__head"><span>{sectionNum.get('guides')}</span><h2>Start here</h2></div>
            <div class="release-guide-grid">
              {release.guides.map((guide) => (
                <a class="release-guide" href={guide.href}>
                  <span class="release-guide__arrow">↗</span>
                  <h3>{guide.title.en}</h3>
                  <p>{guide.body.en}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <section id="highlights" class="release-section">
          <div class="release-section__head"><span>{sectionNum.get('highlights')}</span><h2>Highlights</h2></div>
          <div class="release-highlight-list">
            {release.highlights.map((item, index) => {
              const kind = kindLabel(item.kind);
              return (
                <article class="release-highlight" data-kind={item.kind}>
                  <div class="release-highlight__index">{String(index + 1).padStart(2, '0')}</div>
                  <div>
                    <div class="release-highlight__kind">{kind}</div>
                    <h3>{item.title.en}</h3>
                    <p>{item.body.en}</p>
                    {item.refs?.length && <div class="release-refs">{item.refs.map((ref) => <a href={prHref(ref)}>#{ref}</a>)}</div>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        {(['new', 'improved', 'fixed'] as const).map((kind) => {
          const items = release.changes[kind];
          if (!items.length) return null;
          const label = kindLabel(kind);
          return (
            <section id={kind} class="release-section release-change-section">
              <div class="release-section__head"><span>{sectionNum.get(kind)}</span><h2>{label}</h2></div>
              <div class="release-change-list">
                {items.map((item: ReleaseItem) => (
                  <article>
                    <h3>{item.title.en}</h3>
                    <p>{item.body.en}</p>
                    {item.refs?.length && <div class="release-refs">{item.refs.map((ref) => <a href={prHref(ref)}>#{ref}</a>)}</div>}
                  </article>
                ))}
              </div>
            </section>
          );
        })}

        {release.upgrade.length > 0 && (
          <section id="upgrade" class="release-section">
            <div class="release-section__head"><span>{sectionNum.get('upgrade')}</span><h2>Upgrade notes</h2></div>
            <div class="release-notice-list">
              {release.upgrade.map((item) => (
                <article class:list={["release-notice", `release-notice--${item.level}`]}>
                  <div class="release-notice__icon">{item.level === 'warning' ? '!' : 'i'}</div>
                  <div>
                    <h3>{item.title.en}</h3>
                    <p>{item.body.en}</p>
                    {item.refs?.length && <div class="release-refs">{item.refs.map((ref) => <a href={prHref(ref)}>#{ref}</a>)}</div>}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {release.risks.length > 0 && (
          <section id="risks" class="release-section">
            <div class="release-section__head"><span>{sectionNum.get('risks')}</span><h2>Risk notes</h2></div>
            <div class="release-change-list">
              {release.risks.map((item) => (
                <article>
                  <h3>{item.title.en}</h3>
                  <p>{item.body.en}</p>
                  {item.refs?.length && <div class="release-refs">{item.refs.map((ref) => <a href={prHref(ref)}>#{ref}</a>)}</div>}
                </article>
              ))}
            </div>
          </section>
        )}

        {release.contributors.length > 0 && (
          <section id="thanks" class="release-section release-thanks">
            <div class="release-section__head"><span>{sectionNum.get('thanks')}</span><h2>Thanks</h2></div>
            <p>This release was shaped by:</p>
            <div>{release.contributors.map((name) => <a href={`https://github.com/${name}`}>@{name}</a>)}</div>
          </section>
        )}

        <section id="download" class="release-section release-download">
          <div>
            <p class="release-download__kicker">Ready when you are</p>
            <h2>Ship with a safer Patty Code.</h2>
          </div>
          <div class="release-download__actions">
          <a class="btn btn-dark" href={downloadHref}>Download</a>
            <a class="release-compare" href={release.links.compare}>Full comparison ↗</a>
          </div>
        </section>
      </article>

      <aside class="release-toc">
        <p>In v{release.version}</p>
        <nav>{tocItems.map((item) => <a href={`#${item.id}`}>{item.en}</a>)}</nav>
      </aside>
    </div>
  </main>

  <footer class="release-footer">
    <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="" /><span>Patty Code</span></a>
    <span>© 2026 Patty Code · MIT</span>
    <a href={repo}>GitHub ↗</a>
  </footer>

  <script>
    import '../scripts/changelog.js';
  </script>
</Base>
