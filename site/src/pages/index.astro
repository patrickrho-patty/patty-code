---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import community from '../data/community.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/patty-io/patty-code';
const repoReleases = `${repo}/releases`;
const desktopStableFallback = repoReleases;
const vscodeMarketplace = 'https://marketplace.visualstudio.com/items?itemName=SivanLiu.patty-agent';
const openVsx = 'https://open-vsx.org/extension/SivanLiu/patty-code-agent';
const vscodeExtensionRepo = 'https://github.com/SivanCola/patty-code-vscode';

// Release versions are resolved in the browser from the live channel pointers.
// Static markup says "latest" and uses durable fallbacks instead of baking a
// stale version into every link when a build-time network request fails.
const goVer = 'latest';

const fmtN = (n) => Number(n).toLocaleString('en-US');
const avClass = (i) => 'av' + (i % 5 === 2 ? ' sm' : i % 7 === 3 ? ' lg' : '');
const half = Math.ceil(community.list.length / 2);
const rowA = community.list.slice(0, half);
const rowB = community.list.slice(half);

const desc = "Open-source AI coding agent you can leave running. One local engine, four ways in — terminal, desktop app, browser, or your editor over ACP. Plan mode, permissions, a workspace sandbox and checkpoints keep long autonomous runs reviewable. A single Go binary, no runtime to install. MIT.";
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Patty Code',
  description: desc,
  url: 'https://patty-code.io/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  license: `${repo}/blob/main-v2/LICENSE`,
  downloadUrl: `${repo}/releases`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base
  title="Patty Code — a coding agent you can leave running"
  titleEn="Patty Code — a coding agent you can leave running"
  description={desc}>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" is:inline />

  <SiteHeader />

  <main>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow reveal"><span class="dot"></span>Open source · MIT · a single Go binary</div>
      <h1 class="reveal" style="--d:0.06s">
        A coding agent you can<br /><span class="tt">leave running</span>.
      </h1>
      <p class="sub reveal" style="--d:0.12s">
        One local engine, four ways in — terminal, desktop app, browser, or your editor over ACP. Plan mode, permissions, a workspace sandbox and per-turn checkpoints keep a long autonomous run something you can still read and undo.
      </p>
      <div class="hero-install reveal" style="--d:0.18s" aria-label="Patty Code install options">
        <div class="install-option install-option--desktop">
          <span class="install-kicker">Desktop app</span>
          <strong>Visual workspace for sessions, settings, approvals, and updates.</strong>
          <a class="btn btn-dark" data-os-dl data-goto="desktop" href="#start">Download desktop</a>
        </div>
        <div class="install-option install-option--cli">
          <span class="install-kicker">CLI / TUI</span>
          <strong>Terminal-native agent with the same local Patty Code engine.</strong>
          <span class="install"><span class="ps1">$</span>npm i -g patty-code<button data-copy="npm i -g patty-code">Copy</button></span>
          <a class="install-option__more" href="?download=cli#start" data-goto="cli">Native archives →</a>
        </div>
      </div>
      <nav class="also reveal" style="--d:0.22s" aria-label="More ways to use Patty Code">
        <span class="also-row">
          <strong class="also-label">More ways to use Patty Code:</strong>
          <span class="also-links">
            <a href="?download=vscode#start" data-goto="vscode">Editor extension</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href="#start" data-goto="brew">Homebrew</a>
            <span class="also-sep" aria-hidden="true">·</span>
            <span>Local Web UI: <code>patcode serve</code></span>
            <span class="also-sep" aria-hidden="true">·</span>
            <a href={`${base}/docs/#acp`}>ACP editor integration</a>
          </span>
        </span>
      </nav>

      <div class="term-stage reveal" style="--d:0.26s">
        <div class="fig">fig. 01 — one task, start to finish</div>
        <div class="term">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">~/app — patcode</span></div>
          <div class="term-body"><span class="tl"><span class="t-acc">◆</span> patcode <span class="t-dim"><span class="rxv">{goVer}</span> · deepseek-v4-flash · ~/app</span></span><span class="tl"><span class="t-vio">›</span> add retry with backoff to the http client</span><span class="tl"><span class="t-acc">◇</span> plan <span class="t-dim">3 steps · 2 files · 1 test run</span></span><span class="tl"><span class="t-warm">●</span> allow <span class="t-dim">edit internal/net/client.go</span>  <span class="t-ok">yes</span></span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client.go</span>  <span class="t-add">+24 −3</span></span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client_test.go</span>  <span class="t-add">+41 −0</span></span><span class="tl"><span class="t-ok">✓</span> run <span class="t-dim">go test ./internal/net/</span>  <span class="t-ok">ok</span> <span class="t-dim">(0.21s)</span></span><span class="tl"><span class="t-acc">◆</span> checkpoint <span class="t-dim">#14 — revert this turn anytime</span></span><span class="tl"><span class="t-vio">›</span> <span class="caret"></span></span></div>
          <div class="term-stat"><span>surface <b>cli</b></span><span>tools <b data-cnt="9" data-suf=" calls">9 calls</b></span><span>session <b data-cnt="18" data-suf="m">18m</b></span><span>cost <b data-cnt="0.043" data-dec="3" data-pre="$">$0.043</b></span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker">Features</span>
        <h2>Autonomy you can <span class="em">actually audit.</span></h2>
        <p>Letting an agent run for hours is only useful if you can see what it did and undo the parts you don't want. Every layer here exists for that: plan first, gate each tool call, checkpoint every turn.</p>
      </div>
      <div class="feat-grid">
        <div class="feat reveal">
          <span class="tag">01 / permissions</span>
          <h3>Every tool call is gated</h3>
          <p>Reads, writes, and shell commands each ask separately, and the workspace sandbox bounds what a command can touch even after you say yes.</p>
          <code class="feat-chip">$ allow edit internal/net/client.go? [y/n/always]</code>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">02 / checkpoints</span>
          <h3>Undo any turn</h3>
          <p>Each turn writes a checkpoint outside git, so a six-hour run rewinds to any point without touching your commit history.</p>
        </div>
        <div class="feat reveal" style="--d:0.04s">
          <span class="tag">03 / plan mode</span>
          <h3>Plan before it touches anything</h3>
          <p><code>/plan</code> holds every write until you've read the plan and approved it.</p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">04 / mcp + skills</span>
          <h3>Extend it without forking it</h3>
          <p>MCP over stdio, SSE, and streamable HTTP merges external tools into one registry. Markdown skills and subagents — explore, research, review, security-review — run with their own isolated tool sets.</p>
          <code class="feat-chip">$ patcode mcp add · ~/.patty/skills/</code>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">05 / single binary</span>
          <h3>One file, no runtime</h3>
          <p>CGO-free Go, cross-compiled for darwin/linux/windows × amd64/arm64. Nothing to install underneath it.</p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">06 / local-first</span>
          <h3>Your key, your machine</h3>
          <p>Bring your own DeepSeek key. The engine runs locally — your code goes to the model you configured and nowhere else. MIT licensed, developed in public.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="surfaces">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker">Surfaces</span>
        <h2>One engine. <span class="em">Four ways in.</span></h2>
        <p>Not four products — one local engine behind four front ends. Sessions, permissions, skills and MCP servers are shared, so a task you start in the terminal is waiting for you in the desktop app.</p>
      </div>
      <div class="surf-grid">
        <div class="surf reveal">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win cli">
              <i class="bar"></i>
              <span class="body"><i class="l" style="--w:62%"></i><i class="l" style="--w:44%"></i><i class="l ok" style="--w:70%"></i><i class="l" style="--w:38%"></i><i class="cur"></i></span>
            </span>
          </div>
          <h3>Terminal</h3>
          <p>Full-screen TUI — diff review, approvals, slash commands.</p>
          <code>patty</code>
        </div>
        <div class="surf reveal" style="--d:0.06s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win app">
              <i class="bar"></i>
              <span class="body"><span class="side"><i></i><i></i><i></i></span><span class="main"><i class="l" style="--w:80%"></i><i class="l" style="--w:55%"></i><i class="l ok" style="--w:66%"></i></span></span>
            </span>
          </div>
          <h3>Desktop app</h3>
          <p>Sessions side by side, settings, approvals, auto-update.</p>
          <code>macOS · Windows · Linux</code>
        </div>
        <div class="surf reveal" style="--d:0.12s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win web">
              <i class="bar url"></i>
              <span class="body"><i class="l" style="--w:72%"></i><i class="l" style="--w:48%"></i><i class="l ok" style="--w:60%"></i><i class="l" style="--w:36%"></i></span>
            </span>
          </div>
          <h3>Browser</h3>
          <p>A local web UI on your own machine. Add auth before you expose it.</p>
          <code>patcode serve</code>
        </div>
        <div class="surf reveal" style="--d:0.18s">
          <div class="surf-art" aria-hidden="true">
            <span class="surf-win ide">
              <i class="bar"></i>
              <span class="body"><span class="tree"><i></i><i></i><i></i><i></i></span><span class="main"><i class="l" style="--w:70%"></i><i class="l add" style="--w:52%"></i><i class="l add" style="--w:44%"></i><i class="l" style="--w:64%"></i></span></span>
            </span>
          </div>
          <h3>Your editor</h3>
          <p>VS Code and VSCodium via the extension; anything else that speaks ACP.</p>
          <code>patcode acp</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section>
    <div class="wrap">
      <div class="steps">
        <div class="step reveal">
          <span class="num">01</span>
          <h3>Install</h3>
          <p>One command. macOS, Linux, Windows, and WSL.</p>
          <code>npm i -g patty-code</code>
        </div>
        <div class="step reveal" style="--d:0.08s">
          <span class="num">02</span>
          <h3>Point it at a repo</h3>
          <p>It maps the codebase once and keeps that map for the rest of the session.</p>
          <code>cd your-project &amp;&amp; patcode</code>
        </div>
        <div class="step reveal" style="--d:0.16s">
          <span class="num">03</span>
          <h3>Open the web UI</h3>
          <p>Keep it local, or add token/password auth before sharing a tunnel or remote port.</p>
          <code>patcode serve --auth token</code>
        </div>
        <div class="step reveal" style="--d:0.24s">
          <span class="num">04</span>
          <h3>Leave it running</h3>
          <p>Queue tasks, review diffs, resume anytime. The session never goes cold.</p>
          <code>› refactor the auth flow</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="community">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker">Community</span>
        <h2>Built in the open, with <span class="em">{community.contributors} contributors.</span></h2>
        <p>Patty Code is MIT-licensed and developed in public. Every issue, every PR, every late-night review made it what it is — thank you.</p>
      </div>
    </div>
    <div class="crew reveal" aria-hidden="false">
      <div class="crew-row">
        <span class="crew-set">
          {rowA.map((c, i) => (
            <a class={avClass(i)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
        </span>
      </div>
      <div class="crew-row rev">
        <span class="crew-set">
          {rowB.map((c, i) => (
            <a class={avClass(i + 3)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
          <a class="av you" data-h="this could be you" href={`${repo}/issues`} target="_blank" rel="noreferrer">+</a>
        </span>
      </div>
    </div>
    <div class="wrap">
      <div class="crew-cta reveal">
        <a class="btn btn-dark" href={repo}>Contribute on GitHub</a>
        <a class="btn btn-ghost" href={`${repo}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`}>Good first issues →</a>
      </div>
      <div class="crew-note reveal">{fmtN(community.stars)} stars · {fmtN(community.mergedPrs)} merged PRs · every avatar above is a real contributor</div>
    </div>
  </section>

  <section class="cta" id="start">
    <h2 class="reveal">Start a session that <span class="em">lasts.</span></h2>
    <p class="reveal" style="--d:0.08s">Open source under MIT. Bring your own DeepSeek API key — your code never leaves your machine and the model.</p>

    <div class="dl reveal" style="--d:0.14s">
      <div class="dl-tabs" role="tablist" aria-label="Download method">
        <button class="dl-tab active" id="download-tab-desktop" type="button" data-pane="desktop" role="tab" aria-controls="download-pane-desktop" aria-selected="true" tabindex="0">Desktop</button>
        <button class="dl-tab" id="download-tab-cli" type="button" data-pane="cli" role="tab" aria-controls="download-pane-cli" aria-selected="false" tabindex="-1">CLI</button>
        <button class="dl-tab" id="download-tab-npm" type="button" data-pane="npm" role="tab" aria-controls="download-pane-npm" aria-selected="false" tabindex="-1">npm</button>
        <button class="dl-tab" id="download-tab-brew" type="button" data-pane="brew" role="tab" aria-controls="download-pane-brew" aria-selected="false" tabindex="-1">Homebrew</button>
        <button class="dl-tab" id="download-tab-vscode" type="button" data-pane="vscode" role="tab" aria-controls="download-pane-vscode" aria-selected="false" tabindex="-1">Editor extension</button>
      </div>

      <div class="dl-pane active" id="download-pane-desktop" data-pane="desktop" role="tabpanel" aria-labelledby="download-tab-desktop">
        <div class="release-channel-summary" data-release-summary="desktop" aria-live="polite">
          <span>Current official version <span data-release-version="desktop">latest</span></span>
        </div>
        <div class="os-grid">
          <div class="os-card" data-os="mac">
            <h4>macOS</h4>
            <span class="meta">Universal DMG · Apple Silicon &amp; Intel</span>
            <a class="btn btn-light" href={desktopStableFallback} data-desktop-asset="Patty Code-darwin-universal.dmg">Download Universal · <span data-release-version="desktop">latest</span></a>
            <div class="os-options" aria-label="macOS alternate downloads">
              <a href={desktopStableFallback} data-desktop-asset="Patty Code-darwin-arm64.zip">Apple Silicon zip</a>
              <a href={desktopStableFallback} data-desktop-asset="Patty Code-darwin-amd64.zip">Intel zip</a>
            </div>
          </div>
          <div class="os-card" data-os="win">
            <h4>Windows</h4>
            <span class="meta">Installer · Windows 10+ · x64 / ARM64</span>
            <a class="btn btn-light" href={desktopStableFallback} data-desktop-asset="Patty Code-windows-amd64-installer.exe">Download · <span data-release-version="desktop">latest</span></a>
            <div class="os-options" aria-label="Windows alternate downloads">
              <a href={desktopStableFallback} data-desktop-asset="Patty Code-windows-arm64-installer.exe">ARM64 installer</a>
              <a href={desktopStableFallback} data-desktop-asset="Patty Code-windows-amd64.zip">Portable zip</a>
            </div>
          </div>
          <div class="os-card" data-os="linux">
            <h4>Linux</h4>
            <span class="meta">Debian / Ubuntu package · amd64</span>
            <a class="btn btn-light" href={desktopStableFallback} data-desktop-asset="Patty Code-linux-amd64.deb">Download .deb · <span data-release-version="desktop">latest</span></a>
            <div class="os-options" aria-label="Linux alternate downloads">
              <a href={desktopStableFallback} data-desktop-asset="Patty Code-linux-amd64.tar.gz">Generic tar.gz</a>
              <a href={`${repo}/releases`}>All releases</a>
            </div>
          </div>
        </div>
        <div class="dl-note">Patty Code checks official releases automatically · <a href={`${base}/changelog/`} data-release-notes="desktop">release notes →</a> · <a href={`${repo}/releases`}>all releases →</a></div>
        <div class="dl-help">
          <strong>macOS opens with a quarantine warning?</strong>
          <span>If the app was installed from the official download and placed in <code>/Applications</code>, quit Patty Code, then run:</span>
          <code>sudo xattr -rd com.apple.quarantine /Applications/Patty Code.app</code>
          <button type="button" data-copy="sudo xattr -rd com.apple.quarantine /Applications/Patty Code.app">Copy</button>
          <a href={`${base}/docs/#macos-quarantine`}>When to use this →</a>
        </div>
      </div>

      <div class="dl-pane" id="download-pane-cli" data-pane="cli" role="tabpanel" aria-labelledby="download-tab-cli" hidden>
        <div class="release-channel-summary" data-release-summary="cli" aria-live="polite">
          <span>Current official version <span data-release-version="cli">latest</span></span>
        </div>
        <span class="install release-upgrade-command"><span class="ps1">$</span><span data-release-command="cli">patcode upgrade</span><button data-copy="patcode upgrade">Copy</button></span>
        <div class="os-grid cli-os-grid">
          <div class="os-card" data-os="mac">
            <h4>macOS</h4>
            <span class="meta">Apple Silicon / Intel · tar.gz</span>
            <a class="btn btn-light" href={repoReleases} data-cli-asset="patty-code-darwin-arm64.tar.gz">Apple Silicon · <span data-release-version="cli">latest</span></a>
            <div class="os-options"><a href={repoReleases} data-cli-asset="patty-code-darwin-amd64.tar.gz">Intel tar.gz</a></div>
          </div>
          <div class="os-card" data-os="win">
            <h4>Windows</h4>
            <span class="meta">Windows 10+ · x64 / ARM64 · zip</span>
            <a class="btn btn-light" href={repoReleases} data-cli-asset="patty-code-windows-amd64.zip">Download x64 · <span data-release-version="cli">latest</span></a>
            <div class="os-options"><a href={repoReleases} data-cli-asset="patty-code-windows-arm64.zip">ARM64 zip</a></div>
          </div>
          <div class="os-card" data-os="linux">
            <h4>Linux</h4>
            <span class="meta">amd64 / ARM64 · tar.gz</span>
            <a class="btn btn-light" href={repoReleases} data-cli-asset="patty-code-linux-amd64.tar.gz">Download amd64 · <span data-release-version="cli">latest</span></a>
            <div class="os-options"><a href={repoReleases} data-cli-asset="patty-code-linux-arm64.tar.gz">ARM64 tar.gz</a></div>
          </div>
        </div>
        <div class="dl-note"><a href={repoReleases} data-cli-asset="SHA256SUMS">SHA256SUMS →</a> · <a href={`${base}/changelog/`} data-release-notes="cli">release notes →</a> · npm and Homebrew track the same official version</div>
      </div>

      <div class="dl-pane" id="download-pane-vscode" data-pane="vscode" role="tabpanel" aria-labelledby="download-tab-vscode" hidden>
        <div class="os-grid editor-grid">
          <div class="os-card editor-card editor-card--primary">
            <span class="os-chip">recommended</span>
            <h4>Visual Studio Marketplace</h4>
            <span class="meta">For Microsoft Visual Studio Code</span>
            <a class="btn btn-dark" href={vscodeMarketplace} target="_blank" rel="noreferrer">Install extension</a>
          </div>
          <div class="os-card editor-card">
            <h4>Open VSX Registry</h4>
            <span class="meta">For VSCodium, Eclipse Theia, and compatible editors</span>
            <a class="btn btn-light" href={openVsx} target="_blank" rel="noreferrer">Install from Open VSX</a>
          </div>
        </div>
        <div class="dl-note editor-note">Extension ID <code>SivanLiu.patty-agent</code> · requires Patty Code 1.0+ installed and configured locally · the extension connects to <code>patcode acp</code> and does not bundle the CLI · <a href={vscodeExtensionRepo}>source code →</a></div>
      </div>

      <div class="dl-pane" id="download-pane-npm" data-pane="npm" role="tabpanel" aria-labelledby="download-tab-npm" hidden>
        <span class="install"><span class="ps1">$</span>npm i -g patty-code<button data-copy="npm i -g patty-code">Copy</button></span>
        <div class="chan">
          <div class="chan-row rec">
            <code>npm i -g patty-code</code><span class="v"><span class="rxv">{goVer}</span></span>
            <span class="s">Patty Code 1.x · one binary · no Node · actively developed</span>
            <span class="chan-badge">recommended</span>
          </div>
          <div class="chan-row">
            <code>npm i -g patty-code@0.53.2</code><span class="v">v0.53.2</span>
            <span class="s">deprecated 0.x line · no longer maintained</span>
            <span class="chan-badge pre">deprecated</span>
          </div>
        </div>
        <div class="dl-note">macOS / Linux / Windows / WSL · npm <span class="mono">latest</span> tracks the current official release · <a class="rxnotes" href={`${base}/changelog/`}><span class="rxv">{goVer}</span> release notes →</a></div>
      </div>

      <div class="dl-pane" id="download-pane-brew" data-pane="brew" role="tabpanel" aria-labelledby="download-tab-brew" hidden>
        <span class="install"><span class="ps1">$</span>brew install pattycorp/patty-code<button data-copy="brew install pattycorp/patty-code">Copy</button></span>
        <div class="dl-note"><span class="rxv">{goVer}</span> (Go rewrite) · macOS &amp; Linux · update with <span class="mono">brew upgrade</span></div>
      </div>
    </div>
  </section>
  </main>

  <footer>
    <div class="foot-inner">
      <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="Patty Code logo" /><span>Patty Code</span></a>
