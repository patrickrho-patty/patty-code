---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="Page not found — Patty Code"
  titleEn="Page not found — Patty Code"
  description="The page you are looking for does not exist.">

  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

  <script is:inline>
    // Preserve the documented /u/<handle> shape on static hosting by moving it
    // to the client-rendered public profile page.
    try {
      const match = location.pathname.match(/^\/u\/([^/]+)\/?$/);
      if (match) location.replace(`/u/?handle=${encodeURIComponent(decodeURIComponent(match[1]))}`);
    } catch {}
  </script>

  <SiteHeader scrolled />

  <main class="hero" style="padding-bottom:150px">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h1>This page went <span class="grad">cold.</span></h1>
      <p class="sub">The page you're looking for doesn't exist — but the session is still warm.</p>
      <div class="cold-blocks" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i class="new"></i></div>
      <div class="hero-cta">
        <a class="btn btn-dark" href={`${base}/`}>Back to home</a>
        <a class="btn btn-ghost" href={`${base}/docs/`}>Read the docs</a>
      </div>
    </div>
  </main>
</Base>
