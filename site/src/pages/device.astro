---
import Account from '../layouts/Account.astro';
---
<Account
  title="Authorize a device — Patty Code"
  titleEn="Authorize a device — Patty Code"
  description="Approve a sign-in request from the Patty Code CLI or desktop app.">
  <div id="device-gate" class="auth-head">
    <p>Checking your session…</p>
  </div>

  <div id="device-view" hidden>
    <div class="auth-head">
      <h1>Authorize sign-in</h1>
      <p>Confirm the code shown in your terminal or app.</p>
    </div>

    <div id="device-msg" class="auth-msg" hidden></div>

    <div class="field">
      <label for="device-code">Device code</label>
      <input id="device-code" class="device-code" type="text" autocomplete="one-time-code" spellcheck="false" placeholder="XXXX-XXXX" />
    </div>
    <button id="device-check" type="button" class="btn btn-ghost" style="width:100%">Continue</button>

    <p id="device-meta" class="device-meta" hidden></p>

    <div id="device-actions" class="device-actions" hidden>
      <button id="device-approve" type="button" class="btn btn-dark">Approve</button>
      <button id="device-deny" type="button" class="btn btn-ghost">Reject</button>
    </div>
  </div>
</Account>
